# Reference systemd unit. Prefer `bash scripts/setup-service.sh`, which fills in
# the user / paths / node binary automatically. To use this file manually:
#   1) Edit User, Group, WorkingDirectory and ExecStart (run `which node`).
#   2) sudo cp deploy/nekonabot.service /etc/systemd/system/nekonabot.service
#   3) sudo systemctl daemon-reload && sudo systemctl enable --now nekonabot

[Unit]
Description=nekonabot Discord stats bot
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/nekonabot
ExecStart=/usr/bin/node /home/pi/nekonabot/src/index.js
Restart=on-failure
RestartSec=5
# .env is loaded by the app via dotenv (no EnvironmentFile needed).
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nekonabot
NoNewPrivileges=yes
ProtectSystem=full

[Install]
WantedBy=multi-user.target
