# ===== 必須 =====
# Discord Developer Portal > Bot > Token
DISCORD_TOKEN=
# Discord Developer Portal > General Information > Application ID
CLIENT_ID=

# ===== 任意 =====
# テスト用に1つのサーバーへ即時登録したい場合はそのサーバーIDを設定（空ならグローバル登録：反映に最大1時間）
GUILD_ID=

# 集計・表示
TIMEZONE=Asia/Tokyo
DEFAULT_LOOKBACK_DAYS=7
MAX_TOP_USERS=30

# 追跡の挙動
EXCLUDE_BOTS=true
COUNT_AFK_CHANNEL=false
HEARTBEAT_INTERVAL_SEC=30

# 保存先・フォント
# DATABASE_PATH=./data/nekonabot.db
# 日本語フォントの明示パス（未指定なら自動探索。fonts-noto-cjk 導入で通常は不要）
# FONT_PATH=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc

# ===== 議論フォーラム要約（/forum-active, /forum-summary）=====
# AI要約に使う Google Gemini のキー（https://aistudio.google.com/ で無料取得）
# ★設定する場合は Developer Portal の Bot 設定で「Message Content Intent」を必ず有効化してください
#   （有効化前にキーを設定すると、本文取得用の特権インテント要求で起動できません）
# GEMINI_API_KEY=
# 使用モデル（流動的。例: gemini-2.5-flash / gemini-2.0-flash など。404が出たら変更）
# GEMINI_MODEL=gemini-2.5-flash
# フォーラム機能を許可・登録するサーバーID（自鯖限定）
# FORUM_GUILD_ID=1206513612043325440
# 議論フォーラム（フォーラムチャンネル）のID
# FORUM_CHANNEL_ID=1505504945586049054
# 使用を許可するロールID（カンマ区切り。サーバー管理者は常に可）
# MOD_ROLE_IDS=1206515877499899924,1206515737339101205

# ===== しりとりゲーム =====
# しりとりを行うチャンネルID（このチャンネルの投稿をBotが自動でしりとり判定）
# SHIRITORI_CHANNEL_ID=1483292706414526524

# ===== コマンド実行ログ =====
# スラッシュコマンドの実行を毎回リアルタイムで投稿するチャンネルID（空にすると無効）
# Botがそのチャンネルへ「メッセージを送信」できる必要があります
# LOG_CHANNEL_ID=1521209178100596939
# （任意・参考情報）上記チャンネルが属するサーバーID
# LOG_GUILD_ID=1510242400709378108

# デバッグログを出す場合は任意の値を設定
# DEBUG=1
